---
import ScenicBand from '../../components/ScenicBand.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {
  personSchema,
  breadcrumbSchema,
  pageSchema,
} from '../../lib/schema';

const crumbs = [
  { label: 'About', href: '/about/' },
  { label: 'Morgan Hale, LPC' },
];
---

<Layout
  title="Morgan Hale, LPC | Bozeman Counselor"
  description="Meet Morgan Hale, LPC, a fictional counselor at Horizon Therapy in Bozeman, Montana."
  schema={pageSchema([
    personSchema('/about/morgan-hale/'),
    breadcrumbSchema(crumbs, Astro.url.pathname),
  ])}
>
  <PageHero
    eyebrow="Meet Morgan"
    title="Morgan Hale, LPC"
    intro="Morgan is a fictional Bozeman counselor whose profile demonstrates Horizon Therapy’s reflective, place-oriented approach to individual counseling."
    crumbs={crumbs}
  />

  <section class="morgan-intro">
    <div class="container profile-grid">
      <div class="portrait-frame">
        <img
          src="/images/demo/clinician-placeholder.svg"
          width="700"
          height="780"
          loading="lazy"
          decoding="async"
          alt="Clinician photo placeholder for Morgan Hale, LPC"
        />
        <span>Bozeman, Montana</span>
      </div>

      <div class="profile-copy">
        <p class="eyebrow">Working with Morgan</p>
        <h2>Reflective enough to see the pattern. Practical enough to keep moving.</h2>
        <p>
          Morgan’s fictional counseling style is steady, curious, and oriented
          toward perspective. Sessions make room to understand the terrain
          around a problem instead of treating the most obvious symptom as the
          entire story.
        </p>
        <p>
          The work may slow down a reaction, look at how a transition changed
          your sense of direction, or identify where old expectations are still
          shaping current choices.
        </p>
      </div>
    </div>
  </section>

  <ScenicBand
    image="/images/scenes/river-forest.jpg"
    eyebrow="A wider view"
    title="Perspective can create movement without forcing it."
    position="center"
  />

  <section class="morgan-methods">
    <div class="container methods-grid">
      <div>
        <p class="eyebrow">Ways Morgan may work</p>
        <h2>Several maps, one conversation.</h2>
      </div>

      <div>
        <p>
          Morgan may draw from trauma-informed counseling, Internal Family
          Systems concepts, body-informed work, emotionally focused ideas, and
          mindfulness depending on what helps clarify the work.
        </p>
        <p>
          No single approach is presented as the answer to every concern. A
          framework is useful when it helps you understand your experience and
          find more room for choice.
        </p>
        <a href="/approaches/">Explore Horizon’s therapy approaches →</a>
      </div>
    </div>
  </section>

  <section class="morgan-demo">
    <div class="container demo-grid">
      <div>
        <p class="eyebrow">About this profile</p>
        <h2>A fictional clinician for a fictional practice.</h2>
      </div>

      <div>
        <p>
          Morgan Hale, LPC, is not a real provider. This profile demonstrates
          how a premium practice site can connect clinician story, service
          scope, approaches, and a distinctive visual identity without
          inventing real-world credentials.
        </p>
        <p>
          A client website would replace these demonstration details with
          verified education, licensing, training, specialties, and
          professional history supplied by the clinician.
        </p>
      </div>
    </div>
  </section>

  <section class="morgan-final">
    <div class="container final-grid">
      <div>
        <p class="eyebrow">Where to go next</p>
        <h2>Start with what you are navigating.</h2>
      </div>
      <div class="final-links">
        <a href="/services/">Explore services →</a>
        <a href="/contact/">Contact Horizon →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .morgan-intro,
  .morgan-methods,
  .morgan-demo,
  .morgan-final {
    padding:clamp(4.5rem,8vw,7rem) 0;
  }

  .profile-grid,
  .methods-grid,
  .demo-grid,
  .final-grid {
    display:grid;
    gap:2.5rem;
    align-items:center;
  }

  .portrait-frame {
    width:min(100%,26rem);
    justify-self:center;
    padding:.8rem .8rem 1rem;
    background:#f3eee3;
    box-shadow:0 22px 50px rgba(16,45,47,.14);
  }

  .portrait-frame img {
    display:block;
    width:100%;
    aspect-ratio:35/39;
    object-fit:cover;
    background:#dde4dd;
  }

  .portrait-frame span {
    display:block;
    margin-top:.75rem;
    color:#667873;
    font-size:.76rem;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .profile-copy h2,
  .methods-grid h2,
  .demo-grid h2,
  .final-grid h2 {
    font-family:Georgia,"Times New Roman",serif;
    font-weight:500;
    letter-spacing:-.04em;
  }

  .profile-copy h2 {
    max-width:14ch;
    font-size:clamp(2.5rem,4.8vw,4.5rem);
    line-height:.98;
  }

  .morgan-methods {
    background:#edf0e8;
  }

  .morgan-methods a,
  .final-links a {
    color:#315a5a;
    font-weight:800;
  }

  .morgan-demo {
    background:#f6f1e7;
  }

  .morgan-final {
    background:#173b3d;
    color:#e7efeb;
  }

  .morgan-final h2,
  .morgan-final .eyebrow,
  .morgan-final a {
    color:white;
  }

  .final-links {
    display:grid;
    gap:.75rem;
  }

  @media(min-width:48rem) {
    .profile-grid {
      grid-template-columns:.8fr 1.2fr;
      gap:clamp(3rem,7vw,7rem);
    }

    .methods-grid,
    .demo-grid,
    .final-grid {
      grid-template-columns:1fr 1fr;
      gap:clamp(3rem,7vw,7rem);
      align-items:start;
    }
  }
</style>
