---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
  organizationSchema,
  websiteSchema,
  pageSchema,
} from '../lib/schema';
---

<Layout
  title="Horizon Therapy | Therapy in Bozeman, Montana"
  description="Individual counseling in Bozeman, Montana for adults navigating anxiety, grief, stress, relationships, transitions, and difficult seasons of life."
  schema={pageSchema([organizationSchema(), websiteSchema()])}
>
  <section class="hz-hero">
    <div class="hero-overlay"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">Horizon Therapy · Bozeman, Montana</p>

        <h1>
          Therapy for
          <em>where you are now,</em>
          and where you’re wanting to go.
        </h1>

        <p>
          A supportive space to navigate life’s challenges, gain clarity, and
          move toward meaningful change.
        </p>

        <div class="hero-actions">
          <Button href={appointmentUrl} tracking="request-appointment">
            Request an appointment
          </Button>

          <a href="/services/" class="hero-secondary">
            Explore services
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="hz-values">
    <div class="container value-grid">
      <article>
        <span>01</span>
        <h2>Evidence-informed</h2>
        <p>Thoughtful approaches grounded in clinical training and real-world experience.</p>
      </article>

      <article>
        <span>02</span>
        <h2>Whole-person focus</h2>
        <p>Mind, body, relationships, and life context can all matter in the work.</p>
      </article>

      <article>
        <span>03</span>
        <h2>Personalized care</h2>
        <p>Therapy is shaped around your concerns, goals, preferences, and pace.</p>
      </article>

      <article>
        <span>04</span>
        <h2>Meaningful change</h2>
        <p>Insight and practical tools can help support movement beyond feeling stuck.</p>
      </article>
    </div>
  </section>

  <section class="hz-about">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">A supportive space for real life</p>
        <h2>Room to understand what is happening and what you want to change.</h2>
      </div>

      <div>
        <p>
          You do not need to arrive with everything figured out. Therapy can
          begin with what feels difficult, confusing, repetitive, or simply
          different from how you want life to feel.
        </p>

        <p>
          Morgan works collaboratively with adults to better understand
          patterns, navigate difficult seasons, and identify possibilities for
          meaningful change.
        </p>

        <a class="hz-text-link" href="/about/">
          Learn about Horizon Therapy →
        </a>
      </div>
    </div>
  </section>

  <section class="hz-scenic hz-scenic-forest">
    <div class="scenic-overlay"></div>

    <div class="container scenic-copy">
      <p class="eyebrow scenic-eyebrow">A quieter place to begin</p>

      <h2>
        Sometimes clarity starts by giving yourself room to slow down.
      </h2>
    </div>
  </section>

  <section class="hz-services">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Areas of support</p>
          <h2>Support for what you’re navigating.</h2>
        </div>

        <a href="/services/" class="hz-text-link">
          View all services →
        </a>
      </div>

      <div class="service-grid">
        {
          homepageServices.slice(0, 6).map((service) => (
            <a class="service-card" href={`/services/${service.slug}/`}>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span>Learn more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="hz-scenic hz-scenic-water">
    <div class="scenic-overlay water-overlay"></div>

    <div class="container water-copy">
      <p class="eyebrow scenic-eyebrow">Therapy approaches</p>

      <h2>Different paths can lead toward the same goal.</h2>

      <p>
        Morgan may draw from several therapeutic approaches depending on what
        you are working through and what feels useful in the process.
      </p>

      <a href="/approaches/" class="scenic-link">
        Explore approaches →
      </a>
    </div>
  </section>

  <section class="hz-morgan">
    <div class="container morgan-grid">
      <div class="morgan-image">
        <img
          src="/images/scenes/clinician-forest.jpg"
          alt="Sunlit forest path used as scenic imagery for the fictional clinician profile"
          loading="lazy"
        />
      </div>

      <div>
        <p class="eyebrow">Meet Morgan Hale, LPC</p>

        <h2>Thoughtful counseling grounded in collaboration and respect.</h2>

        <p>
          Morgan works with adults navigating anxiety, grief, stress,
          relationships, life transitions, emotional disconnection, and other
          difficult experiences.
        </p>

        <p>
          Sessions are designed to be practical, reflective, and responsive to
          what each client needs from therapy.
        </p>

        <a class="hz-text-link" href="/about/morgan-hale/">
          Meet Morgan →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hz-hero {
    position: relative;
    min-height: clamp(38rem, 82vh, 55rem);
    display: flex;
    align-items: center;
    background-image: url('/images/scenes/home-hero.jpg');
    background-size: cover;
    background-position: center;
    color: white;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8,31,34,.84) 0%,
        rgba(8,31,34,.62) 36%,
        rgba(8,31,34,.22) 68%,
        rgba(8,31,34,.06) 100%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-copy {
    max-width: 46rem;
  }

  .hero-kicker {
    margin-bottom: 1.2rem;
    color: #e3b05b;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 0;
    color: white;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 7vw, 6.6rem);
    font-weight: 500;
    line-height: .96;
    letter-spacing: -.045em;
  }

  .hero-copy h1 em {
    display: block;
    color: #e1ad53;
    font-weight: 500;
  }

  .hero-copy > p:not(.hero-kicker) {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .9rem;
    margin-top: 2rem;
  }

  .hero-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: .7rem 1.1rem;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 999px;
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .hz-values {
    padding: 3rem 0;
    background: #f6f0e6;
  }

  .value-grid {
    display: grid;
    gap: 1.5rem;
  }

  .value-grid article {
    padding-top: 1rem;
    border-top: 1px solid #cdbfa7;
  }

  .value-grid span {
    color: #b78029;
    font-size: .72rem;
    font-weight: 900;
  }

  .value-grid h2 {
    margin-top: .5rem;
    font-size: 1.15rem;
  }

  .value-grid p {
    margin-top: .4rem;
    font-size: .92rem;
  }

  .hz-about,
  .hz-services,
  .hz-morgan,
  .hz-location {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
  }

  .about-grid,
  .morgan-grid {
    display: grid;
    gap: 3rem;
  }

  .about-grid h2,
  .hz-services h2,
  .hz-morgan h2,
  .hz-location h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
  }

  .about-grid h2 {
    max-width: 15ch;
    font-size: clamp(2.4rem, 5vw, 4rem);
  }

  .about-grid p + p {
    margin-top: 1rem;
  }

  .hz-text-link {
    display: inline-block;
    margin-top: 1.2rem;
    color: #1f5a59;
    font-weight: 800;
    text-decoration: none;
  }

  .hz-scenic {
    position: relative;
    min-height: 31rem;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    color: white;
  }

  .hz-scenic-forest {
    background-image: url('/images/scenes/forest-feature.jpg');
  }

  .hz-scenic-water {
    background-image: url('/images/scenes/water-feature.jpg');
  }

  .scenic-overlay {
    position: absolute;
    inset: 0;
    background: rgba(7,35,34,.55);
  }

  .water-overlay {
    background:
      linear-gradient(
        90deg,
        rgba(7,35,34,.76),
        rgba(7,35,34,.32)
      );
  }

  .scenic-copy,
  .water-copy {
    position: relative;
    z-index: 2;
    max-width: 45rem;
  }

  .scenic-eyebrow {
    color: #e3b05b !important;
  }

  .scenic-copy h2,
  .water-copy h2 {
    color: white;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    font-weight: 500;
    line-height: 1;
  }

  .water-copy p {
    max-width: 38rem;
  }

  .scenic-link {
    display: inline-block;
    margin-top: 1.3rem;
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .hz-services {
    background: #f6f0e6;
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .service-grid {
    display: grid;
    gap: 1rem;
  }

  .service-card {
    padding: 1.4rem;
    border: 1px solid #d6cab6;
    background: rgba(255,255,255,.55);
    color: #4c5a56;
    text-decoration: none;
  }

  .service-card h3 {
    color: #153b3b;
  }

  .service-card span {
    display: inline-block;
    margin-top: .8rem;
    color: #a66d1f;
    font-weight: 750;
  }

  .morgan-image img {
    width: 100%;
    min-height: 28rem;
    object-fit: cover;
    border-radius: .25rem;
  }

  .hz-location {
    background: #163f3f;
    color: #e8eee9;
  }

  .location-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
  }

  .hz-location h2 {
    color: white;
    font-size: clamp(2.4rem, 5vw, 4rem);
  }

  .hz-location .eyebrow {
    color: #e3b05b;
  }

  @media (min-width:48rem) {
    .value-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .about-grid,
    .morgan-grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(4rem, 8vw, 8rem);
      align-items: center;
    }

    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width:47.999rem) {
    .hz-hero {
      min-height: 43rem;
      background-image: url('/images/scenes/mobile-hero.jpg');
      background-position: center;
    }

    .hero-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(8,31,34,.38) 0%,
          rgba(8,31,34,.72) 58%,
          rgba(8,31,34,.9) 100%
        );
    }

    .hero-inner {
      align-self: end;
      padding-bottom: 3rem;
    }

    .hero-actions {
      display: grid;
    }

    .hero-actions > * {
      width: 100%;
      justify-content: center;
    }

    .hz-scenic {
      min-height: 26rem;
    }
  }
</style>
