---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ScenicBand from '../../components/ScenicBand.astro';
import { approaches } from '../../data/approaches';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Approaches' }];
---

<Layout
  title="Therapy Approaches in Bozeman, Montana"
  description="Explore therapy approaches Morgan Hale may use in individual counseling in Bozeman, Montana."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="Ways the work may unfold"
    title="Different paths can help you see the same terrain differently."
    intro="Horizon presents several therapy approaches as possible routes through the work—not as programs you have to choose before you begin."
    crumbs={crumbs}
  />

  <section class="approach-intro">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Choosing a route</p>
        <h2>A method is useful when it helps you orient.</h2>
      </div>
      <div>
        <p>
          Some approaches pay more attention to internal conflict, some to body
          responses, some to relationships and attachment, and some to what is
          happening in the present moment.
        </p>
        <p>
          Morgan may use one framework for a while, combine several, or return
          to straightforward conversation when that is the clearest way to keep
          moving.
        </p>
      </div>
    </div>
  </section>

  <ScenicBand
    image="/images/scenes/meadow-feature.jpg"
    eyebrow="No single path"
    title="The method should help you find direction—not become the destination."
    position="center 55%"
  />

  <section class="approach-index">
    <div class="container">
      <div class="index-heading">
        <p class="eyebrow">Approaches Morgan may draw from</p>
        <h2>Five ways to enter the work.</h2>
      </div>

      <div class="approach-list">
        {
          approaches.map((approach) => (
            <a href={approach.href} data-track={`approach-${approach.slug}`}>
              <div>
                <h3>{approach.title}</h3>
                <p>{approach.cardDescription}</p>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="approach-close">
    <div class="container close-grid">
      <blockquote>
        You do not need to know the name of the path before you know something needs to change.
      </blockquote>
      <div>
        <p>
          Therapy can begin with the concern itself. Morgan can explain why a
          particular approach might be useful and what other options are
          available if it does not fit.
        </p>
        <div class="close-links">
          <a href="/services/">Explore services →</a>
          <a href="/about/morgan-hale/">Meet Morgan →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .approach-intro,
  .approach-index,
  .approach-close {
    padding:clamp(4.5rem,8vw,7rem) 0;
  }

  .intro-grid,
  .close-grid {
    display:grid;
    gap:2.5rem;
  }

  .approach-intro h2,
  .index-heading h2,
  .approach-close blockquote {
    font-family:Georgia,"Times New Roman",serif;
    font-weight:500;
    letter-spacing:-.04em;
  }

  .approach-intro h2 {
    max-width:13ch;
    font-size:clamp(2.6rem,5vw,4.8rem);
    line-height:.98;
  }

  .approach-index {
    background:#eef0e9;
  }

  .index-heading {
    margin-bottom:2.5rem;
  }

  .index-heading h2 {
    font-size:clamp(2.8rem,5vw,4.8rem);
  }

  .approach-list {
    display:grid;
    gap:1rem;
  }

  .approach-list a {
    display:grid;
    grid-template-columns:1fr auto;
    gap:1.25rem;
    align-items:start;
    padding:1.5rem;
    border:1px solid #bdc6be;
    background:rgba(255,255,255,.52);
    color:#173b3d;
    text-decoration:none;
  }

  .approach-list h3 {
    margin:0 0 .4rem;
    color:#173b3d;
    font-family:Georgia,"Times New Roman",serif;
    font-size:clamp(1.5rem,2.5vw,2.2rem);
    font-weight:500;
  }

  .approach-list p {
    margin:0;
    color:#5d6f6a;
  }

  .approach-list b {
    color:#a77838;
    font-size:1.2rem;
  }

  .approach-list a:hover {
    border-color:#8ba09a;
    background:white;
    color:#173b3d;
  }

  .approach-close {
    background:#173b3d;
    color:#e5ece8;
  }

  .approach-close blockquote {
    max-width:12ch;
    margin:0;
    color:white;
    font-size:clamp(2.7rem,5vw,4.8rem);
    line-height:.98;
  }

  .close-grid > div {
    max-width:38rem;
    align-self:end;
  }

  .close-links {
    display:flex;
    flex-wrap:wrap;
    gap:1rem 1.5rem;
    margin-top:1.25rem;
  }

  .close-links a {
    color:#d4a75d;
    font-weight:800;
  }

  @media(min-width:48rem) {
    .intro-grid,
    .close-grid {
      grid-template-columns:1fr 1fr;
      gap:clamp(3rem,7vw,7rem);
      align-items:start;
    }

    .approach-list {
      grid-template-columns:repeat(2,1fr);
    }

    .approach-list a:nth-child(1),
    .approach-list a:nth-child(5) {
      grid-column:span 2;
    }
  }
</style>
