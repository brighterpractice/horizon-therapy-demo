---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  crumbs?: { label: string; href?: string }[];
}

const { eyebrow, title, intro, crumbs } = Astro.props;

const path = Astro.url.pathname;
const isApproachesOverview =
  path === '/approaches/' || path === '/approaches';

let scene = '/images/scenes/about-hero.jpg';
let position = 'center';

if (path.startsWith('/services/')) {
  scene = '/images/scenes/services-hero.jpg';
  position = 'center';
}

if (path.startsWith('/approaches/')) {
  scene = '/images/scenes/approaches-hero.jpg';
  position = 'center';
}

if (path.startsWith('/about/morgan-hale')) {
  scene = '/images/scenes/clinician-forest.jpg';
  position = 'center';
}

if (path === '/about/' || path === '/about') {
  scene = '/images/scenes/about-hero.jpg';
  position = 'center';
}

if (path.startsWith('/contact')) {
  scene = '/images/scenes/contact-hero.jpg';
  position = 'center';
}
---

<section
  class:list={[
    'page-hero',
    'scenic-page-hero',
    { 'scenic-page-hero--approaches-overview': isApproachesOverview }
  ]}
  style={`--hero-image:url('${scene}');--hero-position:${position}`}
>
  <div class="hero-shade"></div>

  <div class="container hero-layout">
    <div class="hero-meta">
      {crumbs && <Breadcrumbs items={crumbs} />}

      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    </div>

    <div class="hero-content">
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </div>
  </div>
</section>

<style>
  .scenic-page-hero {
    position: relative;
    display: flex;
    min-height: clamp(25rem, 48vw, 36rem);
    align-items: end;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 6rem) 0;
    background-image: var(--hero-image);
    background-position: var(--hero-position);
    background-size: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8,39,39,.83) 0%,
        rgba(8,39,39,.59) 46%,
        rgba(8,39,39,.18) 100%
      );
  }

  .hero-layout {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    gap: 1.5rem;
  }

  .hero-meta {
    align-self: end;
  }

  .scenic-page-hero :global(.eyebrow) {
    color: #e3b05b !important;
  }

  .hero-content h1 {
    max-width: 14ch;
    margin: 0;
    color: white !important;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.04em;
  }

  .intro {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: #eef3f0;
    font-size: clamp(1.03rem, 1.7vw, 1.25rem);
    line-height: 1.65;
  }

  .scenic-page-hero--approaches-overview {
    min-height: clamp(31rem, 54vw, 42rem);
  }

  @media (min-width:48rem) {
    .hero-layout {
      grid-template-columns: .3fr 1fr;
      gap: clamp(3rem,6vw,6rem);
      align-items: end;
    }
  }

  @media (max-width:47.999rem) {
    .scenic-page-hero {
      min-height: 31rem;
      background-position: center;
    }

    .scenic-page-hero--approaches-overview {
      min-height: 35rem;
    }

    .hero-shade {
      background:
        linear-gradient(
          180deg,
          rgba(8,39,39,.18),
          rgba(8,39,39,.82)
        );
    }
  }
</style>
