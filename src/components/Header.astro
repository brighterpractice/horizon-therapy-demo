---
import {
  appointmentUrl,
  clientPortalUrl,
  externalLinkAttrs
} from '../data/site';

const appointmentAttrs = externalLinkAttrs();
const portalAttrs = externalLinkAttrs();
const path = Astro.url.pathname;
---

<header class="hz-header">
  <div class="hz-nav-shell">
    <button
      class="explore-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="horizon-navigation"
      data-menu-open
    >
      <span class="menu-lines" aria-hidden="true">
        <i></i>
        <i></i>
      </span>

      <span class="explore-text">Explore</span>
    </button>

    <a class="hz-brand" href="/" aria-label="Horizon Therapy home">
      <img
        src="/images/branding/horizon-header-logo.png"
        alt="Horizon Therapy"
        width="760"
        height="263"
        fetchpriority="high"
      />
    </a>

    <div class="hz-actions">
      <a
        class="portal-link"
        href={clientPortalUrl}
        target={portalAttrs.target}
        rel={portalAttrs.rel}
        data-track="client-portal"
      >
        Portal
      </a>

      <a
        class="appointment-pill"
        href={appointmentUrl}
        target={appointmentAttrs.target}
        rel={appointmentAttrs.rel}
        data-track="request-appointment"
      >
        <span class="desktop-label">Request appointment</span>
        <span class="mobile-label">Request</span>
      </a>
    </div>
  </div>
</header>

<div
  class="hz-menu"
  id="horizon-navigation"
  hidden
  aria-hidden="true"
>
  <div class="hz-menu-scene" aria-hidden="true"></div>

  <div class="hz-menu-inner">
    <div class="hz-menu-top">
      <a class="menu-brand" href="/">
        <img
          src="/images/branding/horizon-header-logo.png"
          alt="Horizon Therapy"
          width="760"
          height="263"
        />
      </a>

      <button
        class="menu-close"
        type="button"
        data-menu-close
        aria-label="Close navigation"
      >
        Close <span>×</span>
      </button>
    </div>

    <div class="hz-menu-content">
      <nav class="menu-primary" aria-label="Main navigation">
        <a href="/" class:list={{ active: path === '/' }}>
          <span>01</span>
          Home
        </a>

        <a href="/about/" class:list={{ active: path.startsWith('/about') }}>
          <span>02</span>
          About
        </a>

        <a href="/services/" class:list={{ active: path.startsWith('/services') }}>
          <span>03</span>
          Services
        </a>

        <a href="/approaches/" class:list={{ active: path.startsWith('/approaches') }}>
          <span>04</span>
          Approaches
        </a>

        <a href="/contact/" class:list={{ active: path.startsWith('/contact') }}>
          <span>05</span>
          Contact
        </a>
      </nav>

      <aside class="menu-secondary">
        <div>
          <p>Clinician</p>
          <a href="/about/morgan-hale/">Morgan Hale, LPC</a>
        </div>

        <div>
          <p>Common concerns</p>
          <a href="/services/anxiety-stress/">Anxiety & stress</a>
          <a href="/services/trauma-ptsd/">Trauma & PTSD</a>
          <a href="/services/grief-loss/">Grief & loss</a>
        </div>

        <div>
          <p>Existing clients</p>
          <a
            href={clientPortalUrl}
            target={portalAttrs.target}
            rel={portalAttrs.rel}
          >
            Client Portal ↗
          </a>
        </div>
      </aside>
    </div>

    <div class="hz-menu-footer">
      <span>Bozeman, Montana</span>

      <a
        href={appointmentUrl}
        target={appointmentAttrs.target}
        rel={appointmentAttrs.rel}
      >
        Request an appointment →
      </a>
    </div>
  </div>
</div>

<script>
  const openButton = document.querySelector('[data-menu-open]');
  const closeButton = document.querySelector('[data-menu-close]');
  const menu = document.querySelector('#horizon-navigation');

  function openMenu() {
    if (!menu || !openButton) return;

    menu.hidden = false;
    menu.setAttribute('aria-hidden', 'false');
    openButton.setAttribute('aria-expanded', 'true');
    document.body.classList.add('horizon-menu-open');

    requestAnimationFrame(() => {
      menu.classList.add('is-open');
    });
  }

  function closeMenu() {
    if (!menu || !openButton) return;

    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    openButton.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('horizon-menu-open');

    window.setTimeout(() => {
      menu.hidden = true;
    }, 220);
  }

  openButton?.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu?.hidden) {
      closeMenu();
    }
  });
</script>

<style>
  .hz-header {
    position: absolute;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1rem;
  }

  .hz-nav-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    width: min(92rem, calc(100% - 1rem));
    min-height: 4.6rem;
    margin-inline: auto;
    padding: .55rem .7rem;
    border: 1px solid rgba(255,255,255,.26);
    border-radius: 999px;
    background: rgba(12,54,52,.72);
    box-shadow: 0 12px 35px rgba(4,25,25,.18);
    backdrop-filter: blur(16px);
  }

  .explore-trigger {
    display: inline-flex;
    gap: .75rem;
    align-items: center;
    justify-self: start;
    min-height: 3rem;
    padding: .65rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
  }

  .explore-trigger:hover {
    background: rgba(255,255,255,.1);
  }

  .menu-lines {
    display: grid;
    gap: .28rem;
  }

  .menu-lines i {
    display: block;
    width: 1rem;
    height: 2px;
    background: #d8a244;
  }

  .menu-lines i:last-child {
    width: .65rem;
  }

  .hz-brand {
    justify-self: center;
  }

  .hz-brand img {
    display: block;
    width: clamp(9rem, 14vw, 13rem);
    height: auto;
  }

  .hz-actions {
    display: flex;
    gap: .7rem;
    align-items: center;
    justify-self: end;
  }

  .portal-link {
    color: #edf3ef;
    font-weight: 750;
    text-decoration: none;
  }

  .appointment-pill {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    padding: .65rem 1.15rem;
    border-radius: 999px;
    background: #d8a244;
    color: #103d3d;
    font-weight: 850;
    text-decoration: none;
  }

  .appointment-pill:hover {
    background: #e4b45b;
  }

  .mobile-label {
    display: none;
  }

  /* Full viewport overlay lives OUTSIDE the filtered header. */

  .hz-menu[hidden] {
    display: none !important;
  }

  .hz-menu {
    position: fixed;
    z-index: 1000;
    inset: 0;
    overflow-y: auto;
    background: #0b3332;
    opacity: 0;
    transition: opacity .22s ease;
  }

  .hz-menu.is-open {
    opacity: 1;
  }

  .hz-menu-scene {
    position: fixed;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(7,40,39,.97),
        rgba(7,40,39,.82)
      ),
      url('/images/scenes/forest-feature.jpg')
      center / cover no-repeat;
  }

  .hz-menu-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: min(86rem, calc(100% - 3rem));
    min-height: 100vh;
    margin-inline: auto;
    padding: clamp(1.5rem,4vw,3rem) 0;
  }

  .hz-menu-top {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(255,255,255,.18);
  }

  .menu-brand img {
    width: clamp(11rem, 18vw, 16rem);
    height: auto;
  }

  .menu-close {
    border: 0;
    background: transparent;
    color: white;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
  }

  .menu-close span {
    color: #d8a244;
    font-size: 1.3rem;
  }

  .hz-menu-content {
    display: grid;
    flex: 1;
    gap: clamp(3rem,7vw,7rem);
    padding: clamp(3rem,7vw,6rem) 0;
  }

  .menu-primary {
    display: grid;
    align-content: start;
  }

  .menu-primary a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: .35rem 0;
    color: #edf3ef;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem,7vw,6.3rem);
    font-weight: 500;
    line-height: .98;
    text-decoration: none;
  }

  .menu-primary a span {
    padding-top: .65rem;
    color: #91aaa4;
    font-family: system-ui, sans-serif;
    font-size: .7rem;
    font-weight: 900;
  }

  .menu-primary a:hover,
  .menu-primary a.active {
    color: #d8a244;
  }

  .menu-secondary {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .menu-secondary > div {
    display: grid;
    gap: .45rem;
  }

  .menu-secondary p {
    margin: 0 0 .4rem;
    color: #d8a244;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .menu-secondary a {
    color: #dce8e3;
    text-decoration: none;
  }

  .hz-menu-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,.18);
    color: #a8bbb6;
  }

  .hz-menu-footer a {
    color: #d8a244;
    font-weight: 850;
    text-decoration: none;
  }

  :global(body.horizon-menu-open) {
    overflow: hidden;
  }

  @media (min-width:48rem) {
    .hz-menu-content {
      grid-template-columns: 1.4fr .6fr;
    }
  }

  @media (max-width:47.999rem) {
    .hz-header {
      padding: .6rem;
    }

    .hz-nav-shell {
      width: 100%;
      grid-template-columns: auto 1fr auto;
      min-height: 3.8rem;
      padding: .35rem;
    }

    .explore-text,
    .portal-link {
      display: none;
    }

    .explore-trigger {
      min-height: 2.75rem;
      padding: .55rem .7rem;
    }

    .hz-brand img {
      width: 8rem;
    }

    .appointment-pill {
      min-height: 2.7rem;
      padding: .55rem .8rem;
    }

    .desktop-label {
      display: none;
    }

    .mobile-label {
      display: inline;
    }

    .hz-menu-inner {
      width: calc(100% - 2rem);
    }

    .menu-primary a {
      grid-template-columns: 2rem 1fr;
      font-size: clamp(2.6rem,13vw,4.5rem);
    }
  }
</style>
